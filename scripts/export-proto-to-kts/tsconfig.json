{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "baseUrl": "src",
        "outDir": "dist",
        "sourceMap": true,
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true
    },
    "exclude": ["./node_modules", "./typings"]
}
