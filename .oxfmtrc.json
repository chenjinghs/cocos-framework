{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "always",
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "endOfLine": "lf",
    "insertFinalNewline": true,
    "objectWrap": "preserve",
    "printWidth": 200,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "sortPackageJson": true,
    "ignorePatterns": ["packages/**/dist/**", "packages/client/src/generated/**", "packages/client/src/default/game-define/generated/**", "scripts/merge-ledger-cli/output/**"]
}
